[Unit]
Description=HopReach DMR — API topología/simulación (dmrsim -serve)
After=network-online.target

[Service]
User=hopreach
WorkingDirectory=/opt/hopreach
ExecStart=/opt/hopreach/dist/dmrsim -network /opt/hopreach/dmr-network.yaml -serve 127.0.0.1:8090
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
