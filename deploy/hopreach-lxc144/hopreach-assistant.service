[Unit]
Description=HopReach DMR — asistente agéntico (API compatible OpenAI)
After=network-online.target ollama.service

[Service]
User=hopreach
WorkingDirectory=/opt/hopreach
ExecStart=/usr/bin/node /opt/hopreach/tools/assistant/server.js
Environment=ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
Environment=ASSISTANT_MODEL=qwen3:8b
Environment=ASSISTANT_VISION_MODEL=gemma4:12b
Environment=ASSISTANT_EMBED_MODEL=nomic-embed-text
Environment=DMRSIM_URL=http://127.0.0.1:8090
Environment=APP_SCREENSHOT_URL=http://127.0.0.1:8090/dmr.html
Environment=ASSISTANT_PORT=18096
# El navegador de Playwright NO vive en $HOME del que instaló: cache
# compartido de la caja (lo llena install.sh como hopreach).
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/hopreach/pw-cache
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
